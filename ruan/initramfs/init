#!/bin/busybox sh
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
echo "ruan: mainline $(uname -r) userspace alive" > /dev/kmsg
n=0
while true; do
	sleep 5
	n=$((n + 5))
	echo "ruan: alive ${n}s, $(grep MemTotal /proc/meminfo)" > /dev/kmsg
done
